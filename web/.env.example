# PostHog Project API Key만 사용한다. Personal API Key는 브라우저에 넣지 않는다.
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=/ph

# API 주소는 공개 설정이다. 변경하면 브라우저와 SSR을 다시 빌드한다.
VITE_API_BASE_URL=https://bebeggars.duckdns.org
# 개발 Vercel은 development와 개발 API를 함께 지정한다.
VITE_APP_ENV=production
SITE_ORIGIN=https://beggars-five.vercel.app

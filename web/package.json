{
  "name": "delivery-discount-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-logo-manifest.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "npm run test:autocomplete && npm run test:brand-impression && npm run test:survey-dismiss && npm run test:banner-scroll && npm run test:analytics && npm run test:posthog && npm run test:event-contract && npm run test:filters && npm run test:brand-route && npm run test:logo-manifest && npm run test:api-base",
    "test:autocomplete": "node --test src/brandAutocomplete.test.js",
    "test:brand-impression": "node --test src/brandImpression.test.js",
    "test:survey-dismiss": "node --test src/surveyDismiss.test.js",
    "test:analytics": "node scripts/verify-analytics-event-id.mjs",
    "test:posthog": "node scripts/verify-posthog-sdk.mjs",
    "test:event-contract": "node scripts/verify-analytics-event-contract.mjs",
    "prerender": "node scripts/prerender.mjs",
    "test:filters": "node scripts/verify-search-filters.mjs",
    "test:brand-route": "node scripts/verify-brand-route.mjs",
    "test:banner-scroll": "node --test src/bannerScroll.test.js",
    "logos": "node scripts/build-logo-manifest.mjs",
    "test:logo-manifest": "node --test src/logoManifest.test.js",
    "test:api-base": "node scripts/verify-api-base.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "posthog-js": "^1.418.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}

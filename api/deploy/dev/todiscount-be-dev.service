[Unit]
Description=ToDiscount development backend
After=network-online.target
Wants=network-online.target

[Service]
User=todiscount-dev
Group=todiscount-dev
WorkingDirectory=/var/lib/todiscount-be-dev
EnvironmentFile=/etc/todiscount-be-dev.env
ExecStart=/usr/lib/jvm/java-21-openjdk-arm64/bin/java -Xms256m -Xmx1536m -jar /opt/todiscount-be-dev/current.jar
Restart=on-failure
RestartSec=5
MemoryMax=2560M
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/todiscount-be-dev
UMask=0027

[Install]
WantedBy=multi-user.target

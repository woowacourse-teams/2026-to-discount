# Template: render with provision.sh before installing.
[Unit]
Description=ToDiscount development backend
After=network-online.target
Wants=network-online.target

[Service]
User=todiscount-dev
Group=todiscount-dev
WorkingDirectory=@@DATA_DIR@@
EnvironmentFile=@@ENV_FILE@@
ExecStart=@@JAVA_BIN@@ -Xms256m -Xmx1536m -jar @@JAR_FILE@@
Restart=on-failure
RestartSec=5
MemoryMax=2560M
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@@DATA_DIR@@
UMask=0027

[Install]
WantedBy=multi-user.target

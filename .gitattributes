scripts/githooks/* text eol=lf

# 줄바꿈은 LF로 못박는다. 윈도우에서 파이썬이 파일을 다시 쓰면 CRLF가 되어
# 한 줄만 고쳐도 파일 전체가 바뀐 것으로 보였다. 2026-09-23 실측: 땡겨요 링크
# 35줄을 새로 수집했는데 brands.yml diff가 965줄로 떴다.
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.java text eol=lf
